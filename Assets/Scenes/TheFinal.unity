--- !u!114 &1570902926
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1570902923}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 77c47fff229283248a8652fc75e773d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinalEndingScreens
  delayAfterFall: 3
  epilogueText: 'Half-life is the time required for half of a substance to decay.


    World
    War II ended with two nuclear explosions, which marked all materials on Earth
    with a precise timestamp.


    Steel produced before these events is known as
    low-background steel.


    Cobalt-60 has a half-life of 5.2714 years.'
  creditsText: 'This game was created for Ludum Dare 60. The theme was "Old tech".


    I
    was inspired by "A Canticle for Leibowitz" by Walter M. Miller Jr. and the music
    video for "Soulbreaker" by A. G. Cook.


    I dedicate this game to my beloved,
    the angel without whom I would never have moved forward.


    Thanks for playing!'
  panel: {fileID: 2128385366}
  textLabel: {fileID: 608678857}
  continueButton: {fileID: 2040578274}
